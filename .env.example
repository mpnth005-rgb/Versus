# Copy this file to .env (or .env.local) and fill in the values you need.
# The app runs and renders without any of these set, but each integration
# below is inert until its variables are provided — see README.md.

# --- Database --------------------------------------------------------------
# SQLite for local dev. Swap the datasource provider in prisma/schema.prisma
# (and the adapter in lib/prisma.ts) to point at Postgres/MySQL in production.
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth) ------------------------------------------------------
# Required in production; run `npx auth secret` to generate one.
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple — https://developer.apple.com/account/resources/identifiers
# Redirect URI: <your-origin>/api/auth/callback/apple
# The app mints its own client-secret JWT from these (see
# lib/apple-client-secret.ts), so you don't need to regenerate a static
# secret every few months.
AUTH_APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 private key Apple gives you when you create the Sign in with
# Apple key. Paste it with literal "\n" for line breaks if kept on one line.
APPLE_PRIVATE_KEY=
# Alternative to the four APPLE_* vars above: a pre-generated client secret
# JWT (e.g. from `npx auth add apple`). Takes precedence if set.
# AUTH_APPLE_SECRET=

# --- Anthropic (AI text generation + translation grading) ------------------
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# --- Stripe (Versus Upper subscriptions) ------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the monthly (4,99€) and annual (39,99€) Versus Upper plans.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
