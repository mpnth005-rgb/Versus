// Versus — Prisma schema
// Dev datasource is SQLite (see .env / DATABASE_URL). Swap the datasource
// provider to "postgresql" for production — see design/README (moved) or
// the project README for details.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — required shape for @auth/prisma-adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  subscription  Subscription?
  settings      UserSettings?
  exercises     Exercise[]
  flashcards    Flashcard[]
  monthlyUsages MonthlyUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String              @unique
  plan                 Plan                @default(FREE)
  status               SubscriptionStatus  @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tracks the free-tier "N exercises per month" quota.
model MonthlyUsage {
  id             String @id @default(cuid())
  userId         String
  yearMonth      String // "2026-09"
  exercisesUsed  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
}

// SRS parameters are per-user and DB-configurable (see lib/srs.ts) — no
// dedicated admin UI yet, but nothing about the scheduling math is
// hardcoded against these fields, so one can be added later without
// touching business logic.
model UserSettings {
  id                     String @id @default(cuid())
  userId                 String @unique
  dailyNewCardLimit      Int    @default(10)
  // Nullable rather than given a JSON default: Prisma's SQLite migration
  // generator emits an unquoted (invalid-as-JSON) DEFAULT clause for Json
  // fields — e.g. DEFAULT [1,10] instead of DEFAULT '[1,10]' — which
  // SQLite silently mis-stores. lib/deck.ts#getSrsConfig() falls back to
  // DEFAULT_SRS_CONFIG when these are null instead.
  learningStepsMinutes   Json?
  relearningStepsMinutes Json?
  graduatingIntervalDays Float  @default(1)
  easyIntervalDays       Float  @default(4)
  minimumIntervalDays    Float  @default(1)
  easeFactorFloor        Float  @default(130)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Training
// ---------------------------------------------------------------------------

enum TextType {
  LITERARY
  JOURNALISTIC
  DAILY
}

enum Level {
  A2
  B1
  B2
  C1
}

enum ExerciseStatus {
  GENERATING
  READY
  SUBMITTED
  CORRECTING
  CORRECTED
  COMPLETED
}

model Exercise {
  id         String         @id @default(cuid())
  userId     String
  title      String
  textType   TextType
  level      Level
  themes     Json // string[] e.g. ["Science", "Environnement"]
  sourceText String
  wordCount  Int
  status     ExerciseStatus @default(GENERATING)
  createdAt  DateTime       @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation Translation?
  correction  Correction?
  flashcards  Flashcard[]
}

model Translation {
  id          String   @id @default(cuid())
  exerciseId  String   @unique
  content     String
  wordCount   Int
  submittedAt DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// Correction for an exercise. The AI (lib/ai.ts, "Appel 3") only
// classifies errors into the fixed 9-category taxonomy — it never
// computes a score. overallScore/adjustedScore are always derived
// server-side (lib/scoring.ts) from the fixed penalty table, so the
// model can't silently get an addition wrong. sentenceCorrections and
// suggestedCards are structured JSON — see lib/ai.ts for the exact shape.
model Correction {
  id                   String   @id @default(cuid())
  exerciseId           String   @unique
  overallScore         Int
  adjustedScore        Int
  referenceTranslation String
  sentenceCorrections  Json
  suggestedCards       Json
  createdAt            DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Flashcard deck (SM-2-style spaced repetition)
// ---------------------------------------------------------------------------

// Mirrors the 4-state model in the spaced-repetition spec exactly:
// nouvelle/apprentissage/revision/re_apprentissage. Learning and
// relearning share mechanics (step ladders, in minutes) but use
// different step lists and are tracked as distinct states, per spec.
enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

model Flashcard {
  id               String    @id @default(cuid())
  userId           String
  front            String
  back             String
  state            CardState @default(NEW)
  dueAt            DateTime  @default(now())
  // Position within the current learning/relearning step ladder.
  currentStep      Int       @default(0)
  // Only meaningful once the card has graduated to REVIEW — the day-based
  // interval that grows multiplicatively with easeFactor.
  intervalDays      Float    @default(0)
  // Percentage, e.g. 250 == x2.5 (matches the spec's convention, not a
  // 0-1 decimal), floored at UserSettings.easeFactorFloor.
  easeFactor       Float     @default(250)
  sourceExerciseId String?
  createdAt        DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceExercise Exercise? @relation(fields: [sourceExerciseId], references: [id], onDelete: SetNull)
}
